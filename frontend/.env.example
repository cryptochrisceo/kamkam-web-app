# ─────────────────────────────────────────────────────────────────────
# KAMKAM frontend — copy to `.env.local` (local) or set in your host
# (Vercel → Project → Settings → Environment Variables).
#
# NEXT_PUBLIC_* values are sent to the browser. Everything in the
# "SERVER SECRETS" section is read only by Next.js route handlers
# (lib/server/*, guarded by `server-only`) and must NEVER be given a
# NEXT_PUBLIC_ prefix, committed, logged or pasted into chat.
# ─────────────────────────────────────────────────────────────────────

# ── Public ───────────────────────────────────────────────────────────
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "anon public" (or "publishable") key.
# Safe in the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Staging only: show the "Demo account · Fill in" helper on the login page.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# ── SERVER SECRETS (set in the host's env settings, not in git) ─────
# Public base URL of this app (used for Paystack callback URLs), e.g. https://kamkam.example
APP_URL=
# Supabase → Project Settings → API Keys → service_role / secret key.
# Required for every money route. Without it, money features show "not configured".
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (NGN deposits + bank payouts). Dashboard → Settings → API Keys & Webhooks.
# Use sk_test_… on staging; sk_live_… only after Paystack approves the business.
# Webhook URL to set in Paystack: ${APP_URL}/api/payments/webhook
PAYSTACK_SECRET_KEY=
# Optional override (tests point this at a mock server). Default https://api.paystack.co
PAYSTACK_BASE_URL=

# Coinbase Developer Platform — Server Wallets (crypto). portal.cdp.coinbase.com →
# API Keys (Secret API key: id + secret) and Server Wallet → Wallet Secret.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# testnet (Ethereum Sepolia, Base Sepolia, Solana Devnet) or mainnet. Default testnet.
CRYPTO_NETWORK_MODE=testnet
# Optional dedicated RPC endpoints (recommended for production; public RPCs are rate-limited).
ETHEREUM_RPC_URL=
BASE_RPC_URL=
SOLANA_RPC_URL=
# Optional CoinGecko demo API key for NGN prices (mainnet only).
COINGECKO_API_KEY=

# Shared secret for /api/cron/reconcile (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
