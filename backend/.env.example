# ---------------------------------------------------------------
# KAMKAM backend — copy this file to `.env` and adjust if needed.
# ---------------------------------------------------------------

# PostgreSQL connection string (local).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kamkam?schema=public"

# API server port. The frontend expects http://localhost:4000
PORT=4000

# Where the frontend runs (used for CORS). Comma-separate several origins.
CORS_ORIGIN="http://localhost:3000"

# Secret used to sign login tokens. Change this to any long random string.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Demo mode: give new users simulated starter balances so the wallet
# and gift flows can be demonstrated immediately. No real money.
DEMO_STARTER_BALANCES=true

# Simulated settlement timings (milliseconds) for withdrawals / sends.
# Pending -> Processing after SIM_PROCESSING_MS, -> Completed after SIM_COMPLETE_MS more.
SIM_PROCESSING_MS=4000
SIM_COMPLETE_MS=6000
